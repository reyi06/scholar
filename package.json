{
  "name": "my-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --env-file=.env scripts/prerender.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file=.env server/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/db-reset.ts",
    "prerender": "node --env-file=.env scripts/prerender.ts",
    "check:responsive": "node scripts/check-responsive.ts",
    "rehearse": "node scripts/rehearse-demo.ts",
    "db:prune-documents": "node --env-file=.env scripts/prune-documents.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
