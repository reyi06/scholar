# Local development configuration.
#
# Copy this file to `.env` and adjust. `.env` is git-ignored; this example is not.

# Prisma. Relative paths resolve from the project root, so this points at the
# same file the migration created (prisma/dev.db).
DATABASE_URL="file:./prisma/dev.db"

# Port for the local API server (server/index.ts).
API_PORT=8787

# How the browser reaches the API. `/api` uses the Vite dev proxy, which keeps
# requests same-origin so the session cookie works. Leave unset to run the
# frontend against its built-in browser storage instead of the database.
VITE_API_BASE_URL=/api

# Public origin of the deployed site. Used when prerendering to write canonical
# URLs, Open Graph tags and sitemap.json. Set this to the real domain at build
# time, or every generated URL will say example.com.
SITE_URL=https://example.com

# Google sign-in. Server-side only — never put these in a VITE_* variable, which
# would bundle them into the browser.
#
# GOOGLE_CLIENT_ID may hold several ids, comma-separated, so staging and
# production can be served by one deployment. Leave it empty and the sign-in
# button is hidden rather than offered and broken.
#
# Setup: Google Cloud Console -> APIs & Services -> OAuth consent screen
# (External), add the accounts that will sign in under "Test users", then
# Clients -> Create client -> Web application. Add the origin the page is served
# from under "Authorized JavaScript origins" — http://localhost:5173 for
# development, with no trailing slash and no wildcards. No redirect URI is
# needed: this uses the ID-token flow, not an authorization code.
GOOGLE_CLIENT_ID=

# Not used yet, and deliberately left blank. This project verifies the ID token
# against Google's published keys, so there is no code to exchange and no
# secret to hold. It will be needed only if a flow is added that calls a Google
# API on the user's behalf.
GOOGLE_CLIENT_SECRET=

# Where uploaded documents are written. Defaults to ./uploads beside the
# database. A deployment should point this at persistent storage outside the
# build directory, or uploads vanish on the next deploy.
UPLOAD_DIR=

# How outgoing messages are delivered. "console" prints them to the server log,
# which is what a demonstration should use: the one-time code is then visible
# on screen as the flow runs. Any other value fails loudly rather than
# pretending a message was sent.
MAIL_TRANSPORT=console
