# Local development configuration.
#
# Copy this file to `.env` and adjust. `.env` is git-ignored; this example is not.

# Prisma. Relative paths resolve from the project root, so this points at the
# same file the migration created (prisma/dev.db).
DATABASE_URL="file:./prisma/dev.db"

# Port for the local API server (server/index.ts).
API_PORT=8787

# How the browser reaches the API. `/api` uses the Vite dev proxy, which keeps
# requests same-origin so the session cookie works. Leave unset to run the
# frontend against its built-in browser storage instead of the database.
VITE_API_BASE_URL=/api
