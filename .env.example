# Local development configuration.
#
# Copy this file to `.env` and adjust. `.env` is git-ignored; this example is not.

# PostgreSQL. Supabase works with the same variable — use the **direct**
# connection string (port 5432), not the transaction pooler, for migrations.
# Locally, the installer's default superuser password is what we used here; set
# your own before deploying anywhere real.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholar?schema=public"

# Port for the local API server (server/index.ts).
API_PORT=8787

# How the browser reaches the API. `/api` uses the Vite dev proxy, which keeps
# requests same-origin so the session cookie works. Leave unset to run the
# frontend against its built-in browser storage instead of the database.
VITE_API_BASE_URL=/api

# Public origin of the deployed site. Used when prerendering to write canonical
# URLs, Open Graph tags and sitemap.xml. Set this to the real domain at build
# time, or every generated URL will say example.com.
SITE_URL=https://example.com

# Show the one-click test-account buttons on the sign-in page. Development
# builds show them regardless; a deployed build must opt in, because the panel
# fills in working administrator credentials. Only a demo host should set this.
# VITE_SHOW_TEST_ACCOUNTS=true

# Google sign-in. Server-side only — never put these in a VITE_* variable, which
# would bundle them into the browser.
#
# GOOGLE_CLIENT_ID may hold several ids, comma-separated, so staging and
# production can be served by one deployment. Leave it empty and the sign-in
# button is hidden rather than offered and broken.
#
# Setup: Google Cloud Console -> APIs & Services -> OAuth consent screen
# (External), add the accounts that will sign in under "Test users", then
# Clients -> Create client -> Web application. Add the origin the page is served
# from under "Authorized JavaScript origins" — http://localhost:5173 for
# development, with no trailing slash and no wildcards. No redirect URI is
# needed: this uses the ID-token flow, not an authorization code.
GOOGLE_CLIENT_ID=

# Not used yet, and deliberately left blank. This project verifies the ID token
# against Google's published keys, so there is no code to exchange and no
# secret to hold. It will be needed only if a flow is added that calls a Google
# API on the user's behalf.
GOOGLE_CLIENT_SECRET=

# Where uploaded documents are written. Defaults to ./uploads beside the
# database. A deployment should point this at persistent storage outside the
# build directory, or uploads vanish on the next deploy.
UPLOAD_DIR=

# How outgoing messages are delivered. "console" prints them to the server log,
# which is what a demonstration should use: the one-time code is then visible
# on screen as the flow runs. "resend" sends through Resend's API and needs the
# two variables below. Any other value fails loudly rather than pretending a
# message was sent.
MAIL_TRANSPORT=console

# Resend. A sending-only key, restricted to the sending domain, is what belongs
# here: the app never needs an account-wide key. Set the value in `.env` or the
# host's secret store, never in a VITE_* variable and never in git.
RESEND_API_KEY=

# The envelope sender. Must be an address on the domain verified in Resend,
# for example `Scholar <codes@mail.yourdomain.ph>`. Until a domain is verified,
# `onboarding@resend.dev` works for test sends to the account owner's own
# address only.
MAIL_FROM=

# The same seam for one-time codes sent by text. "console" prints the message to
# the server log, addressed to the number in E.164 form (+639171234567). A real
# deployment sets this to its provider's name and adds that provider's adapter
# in server/sms.ts: whether a code went out is reported back to the interface,
# so a transport that was never wired up must fail rather than claim success.
SMS_TRANSPORT=console

# Mobile numbers are stored exactly as the student typed them and normalised to
# E.164 when a code is sent. Nothing here needs a prefix setting: the
# normaliser accepts 09XXXXXXXXX, +639XXXXXXXXX and 639XXXXXXXXX, and refuses
# anything else.

# Set to true only when a reverse proxy sits in front of the API and overwrites
# `x-forwarded-for`. Without it the socket address is used for throttling, which
# cannot be forged; with it but no proxy, a caller could spoof their address.
TRUST_PROXY=false
# Whether an unconfirmed email blocks applying for and saving a scholarship.
#
# Leave this false while the deployment cannot deliver mail to arbitrary
# addresses, which is the case with Resend's onboarding@resend.dev testing
# sender and with the console transport: every new student would be stuck on a
# confirmation screen no code can reach.
#
# Set it to true once a sending domain is verified (or mail goes out through an
# account that can reach anyone), so that applying and saving require a
# confirmed address.
REQUIRE_EMAIL_VERIFICATION=false
